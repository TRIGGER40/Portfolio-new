# OpenAI API key (required for LLM chat)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Alternative name (server also checks this):
# OPENAI_KEY=sk-...

# Optional: OpenAI chat model (default: gpt-4o-mini). Same for Vercel env vars.
# OPENAI_MODEL=gpt-4o-mini

# Optional: If the static site is NOT on the same host as the API (e.g. GitHub Pages),
# set this at build time to your Vercel app origin so chat calls the real API:
# VITE_CHAT_API_BASE=https://your-app.vercel.app

# Optional: API server port for local dev (default: 3001)
# API_PORT=3001

# PostHog analytics (free at https://posthog.com)
# VITE_POSTHOG_KEY=phc_your_project_api_key
# VITE_POSTHOG_HOST=https://us.i.posthog.com
